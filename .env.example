# Copia este archivo a .env (cp .env.example .env). El .env nunca se sube a git.
# Valores por defecto de SD §7.3, ajustados a desarrollo local.

PORT=8080
DATABASE_URL=postgres://canjes:canjes@localhost:5432/canjes?sslmode=disable
LOG_LEVEL=debug
RATE_LIMIT_REDEEM_PER_MIN=10
RATE_LIMIT_ISSUE_PER_MIN=30
# Opcional: URL de webhook de Slack o Google Chat (playbook 10).
NOTIFY_WEBHOOK_URL=
# Proxies de confianza delante de la API para calcular la IP real (playbook 10). 0 = sin proxy.
TRUSTED_PROXY_HOPS=0
